# Voltic Lane AI backend — environment configuration.
# Copy this file to .env and fill in what you have. Every value below is
# optional except where noted; anything left blank simply reports that
# capability as "not configured" rather than failing at random later.

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# SQLite by default (zero setup). For production, point this at Postgres,
# e.g. postgresql://user:pass@host:5432/voltic
DATABASE_URL=file:./prisma/dev.db

# REQUIRED in production (the app refuses to start with the default value).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-insecure-secret-change-me-32chars
JWT_EXPIRES_IN=12h

# REQUIRED in production. Used to derive the AES-256-GCM key that encrypts
# stored third-party credentials at rest.
CREDENTIAL_ENCRYPTION_KEY=dev-insecure-encryption-key-change-me!!

LOG_LEVEL=info

# --- AI providers (Section 6/7) ------------------------------------------
# Leave all three blank to run entirely on the local mock provider (safe
# for development/tests, never presented to users as a real AI response).
DEFAULT_AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Voice (Section 28-30) ------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# --- Business integrations (Sections 33-38) -------------------------------
GITHUB_TOKEN=

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Calendar via a long-lived OAuth refresh token obtained once,
# out-of-band, through Google's own consent screen (see DEVELOPMENT.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Agent loop protection (Section 65) -----------------------------------
AGENT_MAX_STEPS=12
AGENT_MAX_EXECUTION_MS=120000
AGENT_MAX_TOOL_CALLS=20
AGENT_APPROVAL_WAIT_MS=15000

# --- Filesystem tool sandbox (Section 39) ---------------------------------
FILESYSTEM_TOOL_ROOT=./data/workspace
