// Jarvis — core data model.
// Dev/test default is SQLite (file-based, zero external services).
// Production points DATABASE_URL at Postgres; the schema is written to be
// portable between the two (no SQLite- or Postgres-only column types).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  role         String   @default("owner") // owner | member | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  conversations Conversation[]
  memoryItems   MemoryItem[]
  tasks         Task[]
  approvals     Approval[]
  integrations  Integration[]
  activity      ActivityEvent[]
  notifications Notification[]
  scheduledTasks ScheduledTask[]
  credentials   Credential[]
  settings      UserSettings?
}

// Persistent, user-controlled assistant identity, voice, and activation
// configuration (Jarvis spec sections 11/12/28/29). One row per user.
// Deliberately explicit columns rather than a JSON blob so each setting
// has a real default and can be queried/validated individually.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity (Section 12)
  assistantName String @default("Jarvis")

  // Activation (Section 11/87) — activation is independent of AI model
  // and voice-mode selection; it only ever means "begin interaction."
  activationMode  String @default("push_to_talk") // push_to_talk | wake_word | clap | disabled
  wakeWordPhrase  String @default("Jarvis")
  clapSensitivity Float  @default(3.0)
  clapPattern     String @default("double") // single | double | triple
  clapCooldownMs  Int    @default(1500)

  // Voice (Section 28/29/88) — provider selection is explicit and
  // independent of the AI model.
  voiceProvider String  @default("elevenlabs")
  voiceId       String?
  voiceModel    String?
  sttProvider   String  @default("elevenlabs")

  // Jarvis "Eyes" visual perception (see EYES.md). Off by default —
  // screen content is sensitive; the user opts in explicitly. Visual
  // data is never written to this database at all; the two retention
  // settings below bound the IN-MEMORY temporal buffer only (Section:
  // "do not persist visual data unless explicitly required").
  eyesEnabled             Boolean @default(false)
  // structural_only: window/UI-Automation semantic awareness, no pixel
  // capture at all. structural_plus_visual: also allows on-demand,
  // attention-triggered frame capture when a vision-capable, allowed
  // provider needs it (still never periodic).
  eyesMode                String  @default("structural_only")
  // auto: AttentionManager may proactively surface significant changes.
  // manual: visual context is only ever gathered when a tool is
  // explicitly invoked, nothing ambient.
  eyesAttentionMode       String  @default("auto")
  // realtime | balanced | low_power — throttle multiplier applied to
  // event acceptance in AttentionManager (see attentionManager.ts).
  eyesUpdateLatencyPolicy String  @default("balanced")
  // JSON array of AI provider ids (e.g. ["anthropic"]) allowed to
  // receive ANY visual context, text summaries included. Empty by
  // default — nothing is shared until the user explicitly allows a
  // provider, mirroring COMPUTER_COMMAND_ALLOWLIST's empty-by-default
  // pattern.
  eyesAllowedProviders    String  @default("[]")
  // Bounds on the in-memory temporal visual buffer (VisualHistory): how
  // far back "what just happened?" can reach, and how many captured
  // keyframes may be held at once. Both exist so the user controls how
  // much recent screen activity Jarvis holds in RAM; neither causes any
  // of it to be written to disk.
  eyesHistorySeconds      Int     @default(120)
  eyesMaxKeyframes        Int     @default(12)

  updatedAt DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
}

// Encrypted-at-rest third-party credentials (API keys, OAuth tokens).
// `secretEnc` holds an AES-256-GCM ciphertext; the plaintext never touches
// logs, audit records, or model context. See SECURITY.md.
model Credential {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // e.g. "anthropic", "openai", "gemini", "elevenlabs", "shopify", "github", "twilio", "google", "microsoft"
  label       String?
  secretEnc   String   // ciphertext
  secretIv    String
  secretTag   String
  metadata    String?  // JSON string, non-secret config (e.g. shop domain)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider, label])
}

// ---------------------------------------------------------------------------
// Conversation system
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  provider  String?
  model     String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  Message[]
  agentRuns AgentRun[]
  tasks     Task[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String   // system | user | assistant | tool
  content        String   // text content (tool results/tool calls stored as JSON string when role=tool)
  toolCallsJson  String?  // JSON string of tool calls requested by the assistant
  toolCallId     String?  // when role=tool, which call this responds to
  provider       String?
  model          String?
  tokenUsage     String?  // JSON string {promptTokens, completionTokens}
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Memory
// ---------------------------------------------------------------------------

model MemoryItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // preference | project | task | fact | instruction
  key         String?
  content     String
  importance  Int      @default(3) // 1 (low) - 5 (critical)
  provenance  String   // "user_stated" | "inferred" | "task_result"
  scope       String?  // free-form project/task scoping key
  disabled    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?

  @@index([userId, category])
}

// ---------------------------------------------------------------------------
// Tools / plugins
// ---------------------------------------------------------------------------

model ToolDefinition {
  id           String   @id @default(cuid())
  name         String   @unique
  version      String
  description  String
  inputSchema  String   // JSON schema string
  outputSchema String?  // JSON schema string
  permissions  String   // JSON array of permission strings
  source       String   // "builtin" | "plugin" | "mcp"
  pluginId     String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Plugin {
  id           String   @id @default(cuid())
  name         String   @unique
  version      String
  description  String?
  capabilities String?  // JSON array
  config       String?  // JSON string, non-secret
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Agent execution / tasks
// ---------------------------------------------------------------------------

model AgentRun {
  id             String   @id @default(cuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  provider       String
  model          String
  status         String   // running | completed | failed | cancelled
  currentStep    Int      @default(0)
  maxSteps       Int      @default(12)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  error          String?
  finalResult    String?

  toolCalls ToolCallRecord[]
}

model ToolCallRecord {
  id          String   @id @default(cuid())
  agentRunId  String
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolName    String
  input       String   // JSON string
  output      String?  // JSON string
  error       String?
  status      String   // pending | approved | denied | executing | succeeded | failed
  riskLevel   String   @default("low") // low | medium | high | critical
  approvalId  String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  title       String
  goal        String
  status      String   // queued | planning | running | waiting_for_approval | paused | completed | failed | cancelled
  plan        String?  // JSON string: ordered list of planned steps (adaptable)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  steps     TaskStep[]
  approvals Approval[]
  agentRuns AgentRun[]
}

model TaskStep {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  index       Int
  description String
  status      String   // pending | running | waiting_for_approval | completed | failed | skipped
  tool        String?
  input       String?  // JSON string
  output      String?  // JSON string
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Permissions & approvals
// ---------------------------------------------------------------------------

model Approval {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  stepId      String?
  tool        String
  action      String
  parameters  String   // JSON string
  riskLevel   String   // low | medium | high | critical
  status      String   @default("pending") // pending | approved | denied | expired
  requestedAt DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  reason      String?
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model Integration {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // openai | anthropic | gemini | elevenlabs | shopify | github | twilio | google | microsoft
  status       String   @default("not_configured") // not_configured | configured | error | disabled
  capabilities String?  // JSON array
  config       String?  // JSON string, non-secret
  lastHealthCheckAt DateTime?
  lastHealthStatus  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model ScheduledTask {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  cronExpression String
  taskTemplate String   // JSON string: {title, goal, toolAllowList?}
  enabled      Boolean  @default(true)
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String   // matches EventBus catalog, e.g. "tool.completed"
  payload   String   // JSON string, secrets stripped
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   // desktop | email | sms (future)
  title     String
  body      String
  status    String   @default("pending") // pending | sent | failed
  createdAt DateTime @default(now())
  sentAt    DateTime?
}
